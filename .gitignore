# --- Python / Backend ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Per-job uploads and generated output (tracking data, stats, rendered
# video, dashboards) - user data, not source, and can get large fast.
Backend/API/data/

# Pretrained/fine-tuned model weights - large binaries that belong in a
# model registry or release asset, not git history. Some of these
# (e.g. the VideoMAE checkpoint) are well over GitHub's 100MB file limit.
*.pt
*.pth
*.safetensors
*.onnx
*.engine
*.npz
Backend/Analysis/GameStatusDetection/Models/

# Downloaded/derived third-party training datasets (raw Roboflow exports,
# extracted crops, merged train/val splits, cached training frames) -
# regenerable via MachineLearning/datasetGather.py (or, for
# dataset_gameStatusDetection, GameStatusDetection/trainGameStatus.py's own
# caching), and too large (tens of thousands of files) for git history.
# (the trailing /* + negation keeps each folder's own README.md - which
# names the model it feeds - tracked even though its data isn't)
Backend/Analysis/MachineLearning/dataset_actionDetection/*
!Backend/Analysis/MachineLearning/dataset_actionDetection/README.md
Backend/Analysis/MachineLearning/dataset_ballDetection/*
!Backend/Analysis/MachineLearning/dataset_ballDetection/README.md
Backend/Analysis/MachineLearning/dataset_courtDefinition/*
!Backend/Analysis/MachineLearning/dataset_courtDefinition/README.md
Backend/Analysis/MachineLearning/dataset_gameStatusDetection/*
!Backend/Analysis/MachineLearning/dataset_gameStatusDetection/README.md

# Ultralytics' default run/output directory (predictions, training runs) -
# regenerable, not source.
runs/

# --- Node / Frontend ---
node_modules/
Frontend/dist/
Frontend/build/
*.local

# --- Editors / OS ---
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.*
!.env.example
